# Pipeline environment variables.
# Copy to pipeline/.env and fill in real values. Never commit pipeline/.env.

# Anthropic API key, used by phase-b-extract.js and fix-missing-fees.js
ANTHROPIC_API_KEY=your-anthropic-api-key

# Texas Comptroller public data API key, used by phase-c-comptroller.js
COMPTROLLER_API_KEY=your-comptroller-api-key

# Supabase project URL and service role key, used by seed-supabase.js,
# phase-e-import.js, and test-address-match.js.
# The service role key is SECRET: it bypasses row-level security.
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
