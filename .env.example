# Web application environment variables.
# Copy to .env.local and fill in real values. Never commit .env.local.
# The pipeline has its own file: pipeline/.env.example

# Supabase project (Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Anon (public) key. Safe to expose in the browser; access is limited by row-level security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key

# Admin dashboard (/command). Off by default: the route redirects to the home
# page unless this is exactly "true". Leave both of these unset on the public
# portfolio deployment.
ENABLE_ADMIN_DASHBOARD=
# Service role key. SECRET: bypasses row-level security. Only read by /command.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Public URL of the deployed site, used for metadata, sitemap, and robots.txt.
NEXT_PUBLIC_SITE_URL=https://homeownersaligned.com

# Optional. Public source repository. When set, "View source" links appear.
NEXT_PUBLIC_REPO_URL=
